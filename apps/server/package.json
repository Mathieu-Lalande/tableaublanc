    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "@node-rs/argon2": "^2.2.2",
    "@tldraw/store": "5.6.2",
    "@tldraw/sync-core": "5.6.2",
    "@tldraw/tlschema": "5.6.2",
    "@tldraw/validate": "5.6.2",
    "better-auth": "1.7.28",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "file-type": "^22.3.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
