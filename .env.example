# ── Déploiement (docker compose) ─────────────────────────────────────────────
# Domaine public pointant vers le VPS (enregistrement DNS A/AAAA).
DOMAIN=canvas.example.com
# Secret de session (>= 32 caractères) : `openssl rand -base64 48`
AUTH_SECRET=
# Clé de licence tldraw (le watermark « made with tldraw » reste affiché).
VITE_TLDRAW_LICENSE_KEY=

# ── Développement local (pnpm dev) ───────────────────────────────────────────
# NODE_ENV=development
# HOST=127.0.0.1
# PORT=5858
# DATA_DIR=./data
# PUBLIC_ORIGIN=http://localhost:5173
